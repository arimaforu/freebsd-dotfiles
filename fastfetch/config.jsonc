{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

    "logo": {
        "type": "auto",
        "padding": {
            "top": 1,
            "right": 4
        },
        "color": {
            "1": "#00E6D0",
            "2": "#707780"
        }
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys": "#00E6D0",
            "title": "#E6E6E6"
        },
        "brightColor": false
    },

    "modules": [
        "title",
        "separator",

        {
            "type": "host",
            "key": "Host"
        },
        {
            "type": "kernel",
            "key": "Kernel"
        },
        {
            "type": "uptime",
            "key": "Uptime"
        },
        {
            "type": "shell",
            "key": "Shell"
        },
        {
            "type": "wm",
            "key": "WM"
        },

        "break",

        {
            "type": "cpu",
            "key": "CPU"
        },
        {
            "type": "gpu",
            "key": "GPU",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "RAM"
        },
        {
            "type": "disk",
            "key": "Disk"
        },

        "break",

        {
            "type": "terminal",
            "key": "Terminal"
        },
        {
            "type": "localip",
            "key": "IP"
        },

        "break",
        "colors"
    ]
}
