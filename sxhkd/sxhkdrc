# Terminal
super + t
    kitty

# Частота монитора
ctrl + alt + h
    ~/.config/bspwm/scripts/refresh-rate.sh

# Display resolution
ctrl + alt + r
    ~/.config/rofi/scripts/resolution.sh

# Notification history
ctrl + alt + n
    ~/.config/rofi/scripts/notification-history.sh

# Audio output
ctrl + alt + a
    ~/.config/rofi/scripts/audio-output.sh

# Restart desktop
super + shift + r
    ~/.config/bspwm/scripts/restart-desktop.sh

# Power menu
super + shift + q
    ~/.config/rofi/scripts/power-menu.sh

# Clipboard history
super + v
    ~/.config/rofi/scripts/clipboard.sh

Print
    ~/.config/bspwm/scripts/screenshot.sh full

shift + Print
    ~/.config/bspwm/scripts/screenshot.sh area

alt + Print
    ~/.config/bspwm/scripts/screenshot.sh window

super + e
    kitty -e yazi

# Rofi
ctrl + alt + d
    rofi -show drun -theme ~/.config/rofi/theme.rasi

# Close window
super + q
    bspc node -c

# Focus
super + h
    bspc node -f west
super + j
    bspc node -f south
super + k
    bspc node -f north
super + l
    bspc node -f east

# Move window
# Move window with arrows
super + shift + Left
    bspc node -s west

super + shift + Right
    bspc node -s east

super + shift + Up
    bspc node -s north

super + shift + Down
    bspc node -s south

# Workspaces
super + 1
    bspc desktop -f '^1'
super + 2
    bspc desktop -f '^2'
super + 3
    bspc desktop -f '^3'
super + 4
    bspc desktop -f '^4'
super + 5
    bspc desktop -f '^5'
super + 6
    bspc desktop -f '^6'
super + 7
    bspc desktop -f '^7'
super + 8
    bspc desktop -f '^8'
super + 9
    bspc desktop -f '^9'

# Move window to workspace
super + shift + 1
    bspc node -d '^1'
super + shift + 2
    bspc node -d '^2'
super + shift + 3
    bspc node -d '^3'
super + shift + 4
    bspc node -d '^4'
super + shift + 5
    bspc node -d '^5'
super + shift + 6
    bspc node -d '^6'
super + shift + 7
    bspc node -d '^7'
super + shift + 8
    bspc node -d '^8'
super + shift + 9
    bspc node -d '^9'

# Floating
super + shift + space
    bspc node -t ~floating

# File search
ctrl + alt + f
    ~/.config/rofi/scripts/file-search.sh

# Window switcher
ctrl + alt + w
    ~/.config/rofi/scripts/window-switcher.sh

super + b
    firefox

# Workspace switcher
ctrl + alt + s
    ~/.config/rofi/scripts/workspace-switcher.sh
