#!/bin/sh

if command -v vmtoolsd >/dev/null 2>&1; then
    vmtoolsd -n vmusr &
fi

pkill sxhkd 2>/dev/null
sxhkd &
sleep 1

"$HOME/.config/bspwm/scripts/monitors.sh"

bspc config border_width 2
bspc config focused_border_color "#00ffcc"
bspc config normal_border_color "#202020"
bspc config presel_feedback_color "#00ffcc"

xsetroot -solid "#000000"

pkill dunst 2>/dev/null
dunst &

pkill picom 2>/dev/null
picom --config /dev/null -b --backend=xrender \
    --shadow \
    --shadow-radius=8 \
    --shadow-offset-x=-4 \
    --shadow-offset-y=-4 \
    --inactive-opacity=0.92 \
    --active-opacity=1.0

if command -v feh >/dev/null 2>&1 && [ -f "$HOME/Pictures/Wallpapers/y2k.jpg" ]; then
    feh --bg-fill "$HOME/Pictures/Wallpapers/y2k.jpg" &
fi

if command -v xclip >/dev/null 2>&1; then
    pkill -f '[c]lipboard-daemon.sh' 2>/dev/null
    "$HOME/.config/bspwm/scripts/clipboard-daemon.sh" &
fi

pkill -f '[a]udio-watch.sh' 2>/dev/null
"$HOME/.config/bspwm/scripts/audio-watch.sh" &

pkill polybar 2>/dev/null
polybar y2k &

pkill -f "$HOME/.config/bspwm/scripts/desktop-watchdog.sh" 2>/dev/null
"$HOME/.config/bspwm/scripts/desktop-watchdog.sh" &
