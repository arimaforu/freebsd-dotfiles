[colors]
bg = #e60a0a0f
bg2 = #ff15151c
fg = #e8f7f5
muted = #7e8b96
cyan = #00f5d4
cyan2 = #66ffe8
magenta = #ff4fd8
dim = #2b3038
red = #ff5c7a

[bar/y2k]
width = 96%
height = 34
offset-x = 2%
offset-y = 8

background = ${colors.bg}
foreground = ${colors.fg}

radius = 17
border-size = 1
border-color = #4033ffdf

padding-left = 8px
padding-right = 8px

module-margin-left = 4px
module-margin-right = 4px

font-0 = DejaVu Sans:size=10;2
font-1 = DejaVu Sans Mono:size=10;2

modules-left = bspwm
modules-center = xwindow
modules-right = cpu memory date

tray-position = right
tray-padding = 6px
tray-maxsize = 18

enable-ipc = true


[module/bspwm]
type = internal/bspwm

pin-workspaces = true
enable-click = true
enable-scroll = true

label-focused =  %name% 
label-focused-foreground = ${colors.bg}
label-focused-background = ${colors.cyan}
label-focused-padding = 7px

label-occupied =  %name% 
label-occupied-foreground = ${colors.cyan2}
label-occupied-padding = 7px

label-urgent =  %name% 
label-urgent-foreground = ${colors.red}
label-urgent-padding = 7px

label-empty =  %name% 
label-empty-foreground = ${colors.muted}
label-empty-padding = 7px


[module/xwindow]
type = internal/xwindow

label = %title:0:55:...%
label-foreground = ${colors.fg}
label-padding = 8px

format-prefix = "  "
format-suffix = "  "


[module/cpu]
type = internal/cpu
interval = 2

format = <label>
format-prefix = "CPU "
format-prefix-foreground = ${colors.cyan}

label = %percentage%%
label-foreground = ${colors.fg}
label-padding = 5px


[module/memory]
type = internal/memory
interval = 2

format = <label>
format-prefix = "RAM "
format-prefix-foreground = ${colors.magenta}

label = %percentage_used%%
label-foreground = ${colors.fg}
label-padding = 5px


[module/date]
type = internal/date
interval = 1

date = %H:%M
date-alt = %d.%m.%Y

format = <label>

label = %date%
label-foreground = ${colors.cyan2}
label-padding = 7px
